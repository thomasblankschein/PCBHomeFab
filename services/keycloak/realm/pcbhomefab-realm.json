{
  "realm": "pcbhomefab",
  "displayName": "PCBHomeFab",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "verifyEmail": false,
  "editUsernameAllowed": false,
  "rememberMe": true,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "maxFailureWaitSeconds": 900,
  "waitIncrementSeconds": 60,
  "passwordPolicy": "length(10) and notUsername",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1209600,
  "ssoSessionMaxLifespan": 2592000,
  "internationalizationEnabled": true,
  "supportedLocales": ["en", "de"],
  "defaultLocale": "en",
  "clients": [
    {
      "clientId": "pcbhomefab-web",
      "name": "PCBHomeFab user interface",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": ["${PCBHOMEFAB_PUBLIC_URL}/*"],
      "webOrigins": ["${PCBHOMEFAB_PUBLIC_URL}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${PCBHOMEFAB_PUBLIC_URL}/*"
      }
    },
    {
      "clientId": "pcbhomefab-cli",
      "name": "PCBHomeFab scripts (curl, tests)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect"
    }
  ]
}
