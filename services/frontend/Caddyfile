# Serves the static pages of the user interface. Only the gateway talks to this service.
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	respond /healthz 200

	header {
		Content-Security-Policy "default-src 'self'; img-src 'self'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	# /jobs/<id> is one page, the script reads the id from the address.
	@job path_regexp job ^/jobs/[A-Za-z0-9_-]+$
	rewrite @job /job.html

	@tools path /tools
	rewrite @tools /tools.html

	# Language files change with releases and are small: always ask whether they are still current.
	@locales path /locales/*
	header @locales Cache-Control no-cache

	file_server
}
