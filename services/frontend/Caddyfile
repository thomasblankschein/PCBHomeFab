# Serves the static pages of the user interface. Only the gateway talks to this service.
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	respond /healthz 200

	header {
		Content-Security-Policy "default-src 'self'; img-src 'self' blob:; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	# /jobs/<id> is one page, the script reads the id from the address.
	@job path_regexp job ^/jobs/[A-Za-z0-9_-]+$
	rewrite @job /job.html

	@joblist path /jobs
	rewrite @joblist /jobs.html

	@callback path /auth-callback
	rewrite @callback /auth-callback.html

	@tools path /tools
	rewrite @tools /tools.html

	@machines path /machines
	rewrite @machines /machines.html

	# Pages, scripts, language files and the version change with releases: always ask whether they are still current (the
	# ETag keeps this cheap). Without it a browser may mix a cached old module with a new one and show an empty page.
	header Cache-Control no-cache

	file_server
}
