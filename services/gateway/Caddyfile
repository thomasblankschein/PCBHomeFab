# Gateway: the only service that is reachable from outside.
#
# SITE_ADDRESS decides what Caddy serves:
#   :80                    plain HTTP, for a trial or behind another proxy
#   pcbhomefab.example.org public name, Caddy gets a Let's Encrypt certificate (ports 80 and 443 must be reachable)
#   pcbhomefab.home.arpa   with CADDY_TLS="tls internal" a certificate from Caddy's own CA for the homelab
{$SITE_ADDRESS::80} {
	{$CADDY_TLS:}

	encode zstd gzip

	# A job takes up to 8 files of 10 MB each (see MAX_FILES and MAX_UPLOAD_MB of the jobs service).
	request_body {
		max_size {$MAX_REQUEST_MB:100}MB
	}

	header {
		-Server
	}

	respond /healthz 200

	# /api/... goes to the jobs service without the prefix: /api/v1/jobs -> /v1/jobs
	handle_path /api/* {
		reverse_proxy jobs:8000
	}

	handle {
		reverse_proxy frontend:8080
	}
}
