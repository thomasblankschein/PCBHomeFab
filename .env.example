# Copy to .env and adjust. Compose reads it automatically.

# Required: the address users type in the browser, with http:// or https:// and the port if it is not 80/443,
# without a trailing slash. The login (Keycloak) and the job service must agree on it. Use https:// as soon as other
# computers use the service: over plain http passwords and login tokens travel unencrypted.
PCBHOMEFAB_PUBLIC_URL=http://localhost

# Required: passwords (for example: openssl rand -hex 24). The administrator creates the accounts of the users with
# scripts/create_user.sh or in the Keycloak console at <public address>/auth/admin (realm "pcbhomefab"); see
# docs/deployment.md. Keep this file private: chmod 600 .env
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=
# KEYCLOAK_ADMIN_USER=admin
# Who may open the Keycloak console through the gateway: addresses or networks separated by spaces, e.g. the computer of
# the administrator (192.168.2.10/32), or private_ranges. Default: nobody.
# KEYCLOAK_ADMIN_NETWORKS=

# What the gateway serves: ":80" (plain HTTP, only for a trial), a public name, or a homelab name
SITE_ADDRESS=:80
# For a homelab name without public certificate: tls internal
CADDY_TLS=
# Ports published on the host (change them when the defaults are taken)
# PCBHOMEFAB_HTTP_PORT=80
# PCBHOMEFAB_HTTPS_PORT=443

# Optional limits (defaults shown)
# PCBHOMEFAB_MAX_UPLOAD_MB=10
# PCBHOMEFAB_MAX_FILES=8
# PCBHOMEFAB_MAX_BOARDS=200
# PCBHOMEFAB_MAX_JOBS_PER_USER=200
# PCBHOMEFAB_JOB_TIMEOUT_S=300
# PCBHOMEFAB_RATE_LIMIT_PER_HOUR=30
# PCBHOMEFAB_PREVIEW_LIMIT_PER_HOUR=300
# PCBHOMEFAB_MAX_QUEUED=100
# PCBHOMEFAB_WORKERS=2
# MAX_REQUEST_MB=100

# The API documentation at /api/docs (it needs no login, so it is off)
# PCBHOMEFAB_API_DOCS=false

# Own list of panel sizes (TOML) instead of the built-in one, a path inside the jobs container, e.g. /data/panels.toml
# (the file lives in the volume jobs_data, see docs/deployment.md)
# PCBHOMEFAB_PANELS_FILE=

# Own tool library (TOML) instead of the built-in one, a path inside the mill container, e.g. /data/tools.toml
# (the file lives in the volume mill_data, see docs/deployment.md)
# PCBHOMEFAB_TOOLS_FILE=
