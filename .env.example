# Copy to .env and adjust. Compose reads it automatically.

# Required: random secret used to hash client addresses (for example: openssl rand -hex 32)
PCBHOMEFAB_IP_SALT=

# What the proxy serves: ":80" (plain HTTP), a public name, or a homelab name
SITE_ADDRESS=:80
# For a homelab name without public certificate: tls internal
CADDY_TLS=

# Optional limits (defaults shown)
# PCBHOMEFAB_MAX_UPLOAD_MB=10
# PCBHOMEFAB_MAX_FILES=8
# PCBHOMEFAB_MAX_BOARDS=200
# PCBHOMEFAB_JOB_TTL_HOURS=168
# PCBHOMEFAB_JOB_TIMEOUT_S=120
# PCBHOMEFAB_RATE_LIMIT_PER_HOUR=30
# PCBHOMEFAB_MAX_QUEUED=100
# MAX_REQUEST_MB=100
