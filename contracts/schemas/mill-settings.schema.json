{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mill-settings.schema.json",
  "title": "Mill settings",
  "type": "object",
  "required": ["mill"],
  "properties": {
    "mill": {"type": "string", "description": "Mill profile id, see GET /v1/profiles."},
    "flip": {"enum": ["x", "y", "none"], "description": "How the plate is turned over, default from the profile."},
    "tabs": {"type": "boolean", "description": "Default from the profile."},
    "thickness_mm": {"type": "number", "minimum": 0.4, "maximum": 3.2, "default": 1.5},
    "marks": {
      "type": "array",
      "items": {"$ref": "mark.schema.json"},
      "minItems": 2,
      "maxItems": 2,
      "description": "Positioning marks. The one at the lower left after turning the plate becomes X0 Y0 of all programs, the other one is named in the program headers and in programs.json."
    }
  },
  "additionalProperties": false
}
