{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exposure-settings.schema.json",
  "title": "Exposure settings",
  "type": "object",
  "required": ["printer"],
  "properties": {
    "printer": {"type": "string", "description": "Printer profile id, see GET /v1/profiles."},
    "holes": {"enum": ["full", "center", "none"], "default": "full"},
    "exposure_s": {"type": "number", "minimum": 1, "maximum": 3600, "default": 120},
    "frame_left_mm": {"type": "number", "minimum": 0, "maximum": 20, "description": "Calibration, default from the profile."},
    "frame_bottom_mm": {"type": "number", "minimum": 0, "maximum": 20, "description": "Calibration, default from the profile."},
    "mirror_x": {"type": "boolean", "description": "Default from the profile."},
    "marks": {
      "type": "array",
      "items": {"$ref": "mark.schema.json"},
      "minItems": 2,
      "maxItems": 2,
      "description": "Positioning marks to draw (two diagonal quarter circles of copper, about 3.4 mm across with their free ring). Without it no marks are drawn."
    },
    "outputs": {
      "type": "array",
      "items": {"enum": ["mask", "preview", "pm3", "copper"]},
      "uniqueItems": true,
      "minItems": 1,
      "default": ["mask", "preview", "pm3"],
      "description": "`copper` is a picture of the copper on the panel (RGBA, 10 px/mm, top view, not mirrored) for the 3D view."
    }
  },
  "additionalProperties": false
}
