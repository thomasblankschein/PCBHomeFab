{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "programs.schema.json",
  "title": "programs.json",
  "description": "Index file inside the ZIP returned by `mill`.",
  "type": "object",
  "required": ["programs"],
  "properties": {
    "marks": {
      "type": "object",
      "description": "Only with positioning marks: where the second mark is, relative to the first one (X0 Y0).",
      "required": ["second_x_mm", "second_y_mm"],
      "properties": {
        "second_x_mm": {"type": "number"},
        "second_y_mm": {"type": "number"}
      },
      "additionalProperties": false
    },
    "programs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["filename", "title", "tool", "holes", "outlines"],
        "properties": {
          "filename": {"type": "string"},
          "title": {"type": "string"},
          "tool": {"type": "string"},
          "holes": {"type": "integer", "minimum": 0},
          "outlines": {"type": "integer", "minimum": 0},
          "estimated_s": {
            "type": "number",
            "minimum": 0,
            "description": "How long the program runs, in seconds: moves at their feed rates (rapid moves at 1500 mm/min) and waiting times. Not counted: the pause at M0 (tool change, Z0), the acceleration of the machine."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
